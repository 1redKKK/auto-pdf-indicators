# Скопируйте в .env.local если запускаете фронт через `npm run dev` (порт 3000),
# а backend отдельно через `uvicorn app.main:app --reload` (порт 8000).
# Для production (single-command `python run.py`) ничего настраивать не нужно
# — фронт получает данные с того же origin.
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/m10
